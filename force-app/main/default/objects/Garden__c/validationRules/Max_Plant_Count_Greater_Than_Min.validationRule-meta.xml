<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Max_Plant_Count_Greater_Than_Min</fullName>
    <active>true</active>
    <errorConditionFormula>(
    !ISBLANK(Maximum_Plant_Count__c) &amp;&amp; 
    !ISBLANK(Minimum_Plant_Count__c) &amp;&amp; 
    (Maximum_Plant_Count__c &lt; Minimum_Plant_Count__c)
)</errorConditionFormula>
    <errorMessage>The Maximum Plant Count must be greater than or equal to the Minimum Plant Count.</errorMessage>
</ValidationRule>
